#include <streampu.hpp>

#include "PassThrough.hpp"
#include "Comparator.hpp"

#include <iostream>
#include <vector>

int main() try
{
    constexpr int frame_size = 16;
    spu::module::Source_random<int> source(frame_size);
    spu::module::PassThrough pass_through(frame_size);
    spu::module::Comparator comparator(frame_size);

    source["generate::out_data"] = comparator["check::in_ref"];
    source["generate::out_data"] = pass_through["process::in"];
    pass_through["process::out"] = comparator["check::in_got"];

    std::vector<spu::runtime::Task*> first_tasks;
    first_tasks.push_back(&source("generate"));
    spu::runtime::Sequence sequence(first_tasks);

    for (auto& task_type : sequence.get_tasks_per_types())
        for (auto& task : task_type)
        {
            task->set_stats(true);
            task->set_debug(true);
        }

    for (int frame = 0; frame < 3; ++frame)
        sequence.exec_seq();

    if (comparator.has_errors())
    {
        std::cerr << "[FAIL] " << comparator.get_n_errors()
                  << " mismatched element(s) over " << comparator.get_frame_count()
                  << " frame(s)." << std::endl;
        return 1;
    }

    std::cout << "[PASS] No mismatches over " << comparator.get_frame_count()
              << " frame(s)." << std::endl;
    return 0;
}
catch (const std::exception& error)
{
    std::cerr << "[FAIL] " << error.what() << std::endl;
    return 1;
}
