cmake_minimum_required(VERSION 3.20)
project({{ project_name }} LANGUAGES C CXX)

set(CMAKE_C_STANDARD 99)
set(CMAKE_C_STANDARD_REQUIRED ON)
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

if(NOT CMAKE_BUILD_TYPE AND NOT CMAKE_CONFIGURATION_TYPES)
    set(CMAKE_BUILD_TYPE Release CACHE STRING "Build type" FORCE)
endif()

# On x86-64, MIPP (inside AFF3CT) only gets SSE2 without -march=native and lacks some operations.
# Keep the same instruction set as the dependencies installed by `hulotte deps install`.
option(HULOTTE_NATIVE_ARCH "Compile for the instruction set of the build machine on x86-64" ON)
if(HULOTTE_NATIVE_ARCH AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64)$")
    add_compile_options(-march=native)
endif()

set(STREAMPU_ROOT "$ENV{STREAMPU_ROOT}" CACHE PATH "Path to the StreamPU source and build directories")
set(AFF3CT_ROOT "$ENV{AFF3CT_ROOT}" CACHE PATH "Path to the AFF3CT source and build directories; its embedded StreamPU replaces STREAMPU_ROOT")
if(NOT STREAMPU_ROOT AND NOT AFF3CT_ROOT)
    message(FATAL_ERROR "Set STREAMPU_ROOT to a StreamPU installation, or AFF3CT_ROOT to use AFF3CT")
endif()

# Fail at configuration rather than compilation when the graph uses AFF3CT modules without AFF3CT_ROOT.
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/src/main.cpp")
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/src/main.cpp" HULOTTE_MAIN_SOURCE)
if(NOT AFF3CT_ROOT AND HULOTTE_MAIN_SOURCE MATCHES "#include[ \t]*[<\"]aff3ct\\.hpp")
    message(FATAL_ERROR "src/main.cpp includes aff3ct.hpp: set AFF3CT_ROOT instead of STREAMPU_ROOT")
endif()

find_package(Threads REQUIRED)

# Every source directly under src/ belongs to the executable: the example modules can be
# removed or new ones added without editing this file (re-run cmake to pick up the change).
file(GLOB HULOTTE_PROJECT_SOURCES CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/src/*.cpp")
add_executable({{ executable_name }} ${HULOTTE_PROJECT_SOURCES})
target_include_directories({{ executable_name }} PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/src")

if(AFF3CT_ROOT)
    # AFF3CT embeds its own StreamPU: link only libaff3ct so StreamPU symbols are not duplicated.
    file(GLOB HULOTTE_AFF3CT_LIBRARIES "${AFF3CT_ROOT}/build/lib/libaff3ct-*.a")
    if(NOT EXISTS "${AFF3CT_ROOT}/include/aff3ct.hpp" OR NOT HULOTTE_AFF3CT_LIBRARIES)
        message(FATAL_ERROR "AFF3CT headers or libaff3ct-*.a were not found under ${AFF3CT_ROOT}")
    endif()
    list(GET HULOTTE_AFF3CT_LIBRARIES 0 HULOTTE_AFF3CT_LIBRARY)
    target_include_directories({{ executable_name }} PRIVATE
        "${AFF3CT_ROOT}/include"
        "${AFF3CT_ROOT}/lib/streampu/include"
        "${AFF3CT_ROOT}/lib/streampu/src"
        "${AFF3CT_ROOT}/lib/streampu/lib/rang/include"
        "${AFF3CT_ROOT}/lib/streampu/lib/json/include"
        "${AFF3CT_ROOT}/lib/streampu/lib/cpptrace/include"
        "${AFF3CT_ROOT}/lib/cli/src"
        "${AFF3CT_ROOT}/lib/MIPP/src"
        "${AFF3CT_ROOT}/lib/date/include/date"
    )
    target_compile_definitions({{ executable_name }} PRIVATE AFF3CT_MULTI_PREC MIPP_ENABLE_BACKTRACE SPU_COLORS)
    target_link_libraries({{ executable_name }} PRIVATE "${HULOTTE_AFF3CT_LIBRARY}" Threads::Threads)

    file(GLOB_RECURSE HULOTTE_CPPTRACE_LIBRARIES "${AFF3CT_ROOT}/build/*libcpptrace*.a")
    if(HULOTTE_CPPTRACE_LIBRARIES)
        list(GET HULOTTE_CPPTRACE_LIBRARIES 0 HULOTTE_CPPTRACE_LIBRARY)
        target_link_libraries({{ executable_name }} PRIVATE "${HULOTTE_CPPTRACE_LIBRARY}")
        target_compile_definitions({{ executable_name }} PRIVATE SPU_STACKTRACE)
    endif()
else()
    find_path(STREAMPU_INCLUDE_DIR streampu.hpp
        PATHS "${STREAMPU_ROOT}/include"
        NO_DEFAULT_PATH
    )
    find_library(STREAMPU_LIBRARY NAMES streampu
        PATHS "${STREAMPU_ROOT}/build/lib"
        NO_DEFAULT_PATH
    )
    if(NOT STREAMPU_INCLUDE_DIR OR NOT STREAMPU_LIBRARY)
        message(FATAL_ERROR "StreamPU headers or libstreampu.a were not found under ${STREAMPU_ROOT}")
    endif()

    target_include_directories({{ executable_name }} PRIVATE
        "${STREAMPU_INCLUDE_DIR}"
        "${STREAMPU_ROOT}/src"
        "${STREAMPU_ROOT}/lib/rang/include"
        "${STREAMPU_ROOT}/lib/json/include"
        "${STREAMPU_ROOT}/lib/cpptrace/include"
    )
    target_link_libraries({{ executable_name }} PRIVATE "${STREAMPU_LIBRARY}" Threads::Threads)

    find_library(CPPTRACE_LIBRARY NAMES cpptrace
        PATHS "${STREAMPU_ROOT}/build/lib/cpptrace/lib"
        NO_DEFAULT_PATH
    )
    if(CPPTRACE_LIBRARY)
        target_link_libraries({{ executable_name }} PRIVATE "${CPPTRACE_LIBRARY}")
        target_compile_definitions({{ executable_name }} PRIVATE SPU_STACKTRACE)
    endif()
endif()

# C sources hold the implementations behind cfunction modules.
file(GLOB HULOTTE_CUSTOM_MODULE_SOURCES CONFIGURE_DEPENDS
    "${CMAKE_CURRENT_SOURCE_DIR}/src/custom/*.cpp"
    "${CMAKE_CURRENT_SOURCE_DIR}/src/custom/*.c"
)
if(HULOTTE_CUSTOM_MODULE_SOURCES)
    target_sources({{ executable_name }} PRIVATE ${HULOTTE_CUSTOM_MODULE_SOURCES})
endif()

file(GLOB HULOTTE_VERILOG_SOURCES CONFIGURE_DEPENDS
    "${CMAKE_CURRENT_SOURCE_DIR}/src/hw/*.sv"
)
if(HULOTTE_VERILOG_SOURCES)
    # SHA-256 of the RTL sources, for mark_verified() of the Verilator adapters: every .sv under
    # src/hw except src/hw/synth (synthesis wrappers). The manifest lists "<sha256>  <path>" per
    # file, sorted by path; the RTL hash is the SHA-256 of the manifest, computed the same way by
    # `hulotte synth status`. A change in any of these files re-runs this configuration.
    file(GLOB_RECURSE HULOTTE_RTL_FILES CONFIGURE_DEPENDS RELATIVE "${CMAKE_CURRENT_SOURCE_DIR}"
        "${CMAKE_CURRENT_SOURCE_DIR}/src/hw/*.sv"
    )
    list(FILTER HULOTTE_RTL_FILES EXCLUDE REGEX "^src/hw/synth/")
    list(SORT HULOTTE_RTL_FILES)
    set(HULOTTE_RTL_MANIFEST "")
    foreach(HULOTTE_RTL_FILE IN LISTS HULOTTE_RTL_FILES)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/${HULOTTE_RTL_FILE}")
        file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/${HULOTTE_RTL_FILE}" HULOTTE_RTL_FILE_SHA256)
        string(APPEND HULOTTE_RTL_MANIFEST "${HULOTTE_RTL_FILE_SHA256}  ${HULOTTE_RTL_FILE}\n")
    endforeach()
    string(SHA256 HULOTTE_RTL_SHA256 "${HULOTTE_RTL_MANIFEST}")
    string(REPLACE "\n" "\\n" HULOTTE_RTL_MANIFEST_C "${HULOTTE_RTL_MANIFEST}")
    set(HULOTTE_PROJECT_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/hulotte/hulotte_rtl_hash.hpp" @ONLY CONTENT [[
#pragma once
// Generated by CMake from src/hw: see CMakeLists.txt.
#define HULOTTE_PROJECT_DIR "@HULOTTE_PROJECT_DIR@"
#define HULOTTE_RTL_SHA256 "@HULOTTE_RTL_SHA256@"
#define HULOTTE_RTL_MANIFEST "@HULOTTE_RTL_MANIFEST_C@"
]])
    target_include_directories({{ executable_name }} PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/hulotte")

    if(DEFINED ENV{VERILATOR_ROOT})
        find_package(verilator REQUIRED HINTS "$ENV{VERILATOR_ROOT}")
    else()
        find_package(verilator REQUIRED)
    endif()

    foreach(HULOTTE_VERILOG_SOURCE IN LISTS HULOTTE_VERILOG_SOURCES)
        get_filename_component(HULOTTE_BLOCK_NAME "${HULOTTE_VERILOG_SOURCE}" NAME_WE)
        set(HULOTTE_VERILATOR_TARGET "VerilatorModel_${HULOTTE_BLOCK_NAME}")
        add_library(${HULOTTE_VERILATOR_TARGET} STATIC "${HULOTTE_VERILOG_SOURCE}")
        verilate(${HULOTTE_VERILATOR_TARGET}
            SOURCES "${HULOTTE_VERILOG_SOURCE}"
            TOP_MODULE "${HULOTTE_BLOCK_NAME}"
            PREFIX "VModel_${HULOTTE_BLOCK_NAME}"
            TRACE
            VERILATOR_ARGS -Wno-fatal
        )
        target_include_directories(${HULOTTE_VERILATOR_TARGET} PUBLIC
            "${CMAKE_CURRENT_BINARY_DIR}/CMakeFiles/${HULOTTE_VERILATOR_TARGET}.dir"
        )
        target_link_libraries(${HULOTTE_VERILATOR_TARGET} PUBLIC Threads::Threads)
        target_link_libraries({{ executable_name }} PRIVATE ${HULOTTE_VERILATOR_TARGET})
    endforeach()
endif()

enable_testing()
add_test(NAME pipeline_smoke COMMAND {{ executable_name }})
