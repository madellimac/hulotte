# Settings of "odatix fmax", written by `hulotte synth add`. `hulotte synth run` selects the
# block with -a, so the list below only matters when Odatix is run by hand.
---
overwrite:        No
ask_continue:     Yes
exit_when_done:   No
log_size_limit:   300
nb_jobs:          4
force_single_thread: No
architectures:
  - {{ block }}/verified
...
