# Odatix workspace written by `hulotte synth add`. Run Odatix from this directory,
# or let `hulotte synth run` do it. Keys left out take the Odatix defaults.
workspace: odatix
default_tool: {{ tool }}

arch_path: odatix_userconfig/architectures
target_path: odatix_userconfig/targets

synth_settings_file: synth_settings.yml
fmax_settings_file: fmax_settings.yml

work_path: work
result_path: results
