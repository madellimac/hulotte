    void set_stall_limit(std::uint64_t cycles);
    std::uint64_t get_stall_limit() const;

private:
    struct Cycle_range
    {
        std::uint64_t count = 0;
        std::uint64_t min = 0;
        std::uint64_t max = 0;
        std::uint64_t sum = 0;
        void add(std::uint64_t value);
    };

    {{ class_name }}(int n_in, int n_out, bool create_task, const std::string& trace_path);
    void process_frames(const in_t* input, out_t* output, std::size_t n_frames);
    void evaluate();

    int n_in;
    int n_out;
    std::uint64_t stall_limit = 100000;
    Cycle_range latency;
    Cycle_range interval;
    std::shared_ptr<const std::string> trace_reservation;
    std::unique_ptr<VerilatedContext> context;
    std::unique_ptr<VModel_{{ class_name }}> model;
    std::unique_ptr<VerilatedVcdC> trace;
};

