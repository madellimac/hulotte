{
}

{{ class_name }}::{{ class_name }}(int n_in, int n_out, bool create_task, const std::string& trace_path)
: spu::module::Stateful(), n_in(n_in), n_out(n_out)
{
    if (n_in <= 0 || n_out <= 0)
        throw std::invalid_argument("Frame sizes must be positive in {{ class_name }}");
    {
        std::lock_guard<std::mutex> lock(verilator_initialization_mutex());
        context = std::make_unique<VerilatedContext>();
        context->timeunit(-9);
        context->timeprecision(-9);
        context->traceEverOn(!trace_path.empty());
        model = std::make_unique<VModel_{{ class_name }}>(context.get());
    }

    if (!trace_path.empty())
    {
        trace_reservation = hulotte::detail::reserve_vcd_path(trace_path);
        const std::filesystem::path path(trace_path);
        if (path.has_parent_path())
            std::filesystem::create_directories(path.parent_path());
        trace = std::make_unique<VerilatedVcdC>();
        model->trace(trace.get(), 99);
        trace->open(trace_path.c_str());
        if (!trace->isOpen())
            throw std::runtime_error("Cannot open VCD trace: " + trace_path);
    }

    this->set_name("{{ class_name }}");
    this->set_short_name("{{ class_name }}");
    // All the frames of an execution reach the codelet together, so they can overlap in the model.
    this->set_single_wave(true);

    model->clk = 0;
    model->reset = 1;
    model->in_valid = 0;
    model->in_last = 0;
    clear_port(model->in_data);
    model->out_ready = 0;
    evaluate();
    model->clk = 1;
    evaluate();
    model->clk = 0;
    model->reset = 0;
    evaluate();

    if (create_task)
    {
        auto& task = this->create_task("simulate");
        auto input_socket = this->create_socket_in<in_t>(task, "input", n_in);
        auto output_socket = this->create_socket_out<out_t>(task, "output", n_out);
        this->create_codelet(task, [input_socket, output_socket](spu::module::Module& module, spu::runtime::Task& task, const size_t)
        {
            auto& adapter = static_cast<{{ class_name }}&>(module);
            const auto* input = static_cast<const in_t*>(task[input_socket].get_dataptr());
            auto* output = static_cast<out_t*>(task[output_socket].get_dataptr());
            adapter.process_frames(input, output, adapter.get_n_frames_per_wave());
            return spu::runtime::status_t::SUCCESS;
        });
    }
}

{{ class_name }}::~{{ class_name }}()
{
    if (model)
        model->final();
    if (trace)
        trace->close();
}

{{ class_name }}* {{ class_name }}::clone() const
{
    std::unique_ptr<{{ class_name }}> copy(new {{ class_name }}(n_in, n_out, false, ""));
    copy->deep_copy(*this);
    copy->stall_limit = stall_limit;
    return copy.release();
}

void {{ class_name }}::evaluate()
{
    model->eval();
    if (trace)
        trace->dump(context->time());
    context->timeInc(5);
}

void {{ class_name }}::process_frames(const in_t* input, out_t* output, std::size_t n_frames)
{
    const std::size_t beats_in = (static_cast<std::size_t>(n_in) + in_lanes - 1) / in_lanes;
    const std::size_t beats_out = (static_cast<std::size_t>(n_out) + out_lanes - 1) / out_lanes;
    std::vector<std::uint64_t> first_input_cycle(n_frames, 0);
    std::size_t in_frame = 0, in_beat = 0;
    std::size_t out_frame = 0, out_beat = 0;
    std::uint64_t cycle = 0, idle = 0;

    while (out_frame < n_frames && idle < stall_limit)
    {
        const bool sending = in_frame < n_frames;
        model->clk = 0;
        model->in_valid = sending;
        model->in_last = sending && in_beat == beats_in - 1;
        clear_port(model->in_data);
        if (sending)
        {
            const in_t* frame = input + in_frame * n_in;
            for (unsigned lane = 0; lane < in_lanes; ++lane)
            {
                const std::size_t index = in_beat * in_lanes + lane;
                if (index < static_cast<std::size_t>(n_in))
                    write_bits(model->in_data, lane * in_width, in_width,
                               static_cast<std::uint64_t>(static_cast<std::int64_t>(frame[index])));
            }
        }
        model->out_ready = 1;
        evaluate();

        const bool accepted = sending && model->in_ready;
        const bool produced = model->out_valid;
        if (accepted)
        {
            if (in_beat == 0)
                first_input_cycle[in_frame] = cycle;
            if (++in_beat == beats_in)
            {
                in_beat = 0;
                ++in_frame;
            }
        }
        if (produced)
        {
            if (out_frame >= in_frame + (in_beat > 0 ? 1 : 0))
                throw std::runtime_error("{{ class_name }} produced output for frame "
                                         + std::to_string(out_frame) + " before receiving its input");
            out_t* frame = output + out_frame * n_out;
            for (unsigned lane = 0; lane < out_lanes; ++lane)
            {
                const std::size_t index = out_beat * out_lanes + lane;
                if (index < static_cast<std::size_t>(n_out))
                    frame[index] = to_element<out_t>(read_bits(model->out_data, lane * out_width, out_width), out_width);
            }
            if (++out_beat == beats_out)
            {
                latency.add(cycle - first_input_cycle[out_frame]);
                out_beat = 0;
                ++out_frame;
            }
        }

        model->clk = 1;
        evaluate();
        idle = (accepted || produced) ? 0 : idle + 1;
        ++cycle;
    }

    model->clk = 0;
    model->in_valid = 0;
    model->in_last = 0;
    model->out_ready = 0;
    evaluate();
    if (trace)
        trace->flush();

    if (out_frame != n_frames)
    {
        throw std::runtime_error("Verilator frame timeout in {{ class_name }}: no transfer during "
                                 + std::to_string(stall_limit) + " cycles (frame "
                                 + std::to_string(out_frame + 1) + "/" + std::to_string(n_frames)
                                 + ", received " + std::to_string(out_beat * out_lanes) + "/"
                                 + std::to_string(n_out) + " elements)");
    }
    for (std::size_t f = 1; f < n_frames; ++f)
        interval.add(first_input_cycle[f] - first_input_cycle[f - 1]);
}

std::uint64_t {{ class_name }}::get_frame_count() const { return latency.count; }
std::uint64_t {{ class_name }}::get_latency_min() const { return latency.min; }
std::uint64_t {{ class_name }}::get_latency_max() const { return latency.max; }
double {{ class_name }}::get_latency_mean() const
{
    return latency.count ? static_cast<double>(latency.sum) / latency.count : 0.0;
}
std::uint64_t {{ class_name }}::get_interval_count() const { return interval.count; }
std::uint64_t {{ class_name }}::get_interval_min() const { return interval.min; }
std::uint64_t {{ class_name }}::get_interval_max() const { return interval.max; }
double {{ class_name }}::get_interval_mean() const
{
    return interval.count ? static_cast<double>(interval.sum) / interval.count : 0.0;
}

void {{ class_name }}::reset_cycle_stats()
{
    latency = Cycle_range();
    interval = Cycle_range();
}

void {{ class_name }}::print_cycle_stats(std::ostream& stream) const
{
    stream << "{{ class_name }}: " << get_frame_count() << " frame(s), latency min/mean/max = "
           << get_latency_min() << "/" << get_latency_mean() << "/" << get_latency_max() << " cycles";
    if (interval.count)
        stream << ", interval min/mean/max = " << get_interval_min() << "/" << get_interval_mean()
               << "/" << get_interval_max() << " cycles";
    stream << std::endl;
}

void {{ class_name }}::set_stall_limit(std::uint64_t cycles)
{
    if (cycles == 0)
        throw std::invalid_argument("The stall limit of {{ class_name }} must be positive");
    stall_limit = cycles;
}

std::uint64_t {{ class_name }}::get_stall_limit() const { return stall_limit; }

