// Older Verilator releases (5.018 for example) reference the legacy sc_time_stamp() at link time
// even when the time comes from the VerilatedContext, as here. This weak definition satisfies the
// linker, is shared by all adapters and is never called.
#if defined(__GNUC__) || defined(__clang__)
__attribute__((weak)) double sc_time_stamp() { return 0; }
#endif

namespace hulotte::detail {

inline std::shared_ptr<const std::string> reserve_vcd_path(const std::string& trace_path)
{
    static std::mutex trace_mutex;
    static std::set<std::string> active_paths;
    const auto path = std::filesystem::weakly_canonical(trace_path).string();
    std::lock_guard<std::mutex> lock(trace_mutex);
    if (!active_paths.insert(path).second)
        throw std::runtime_error("VCD trace path already in use: " + path);
    return std::shared_ptr<const std::string>(new std::string(path), [](const std::string* reserved_path)
    {
        std::lock_guard<std::mutex> release_lock(trace_mutex);
        active_paths.erase(*reserved_path);
        delete reserved_path;
    });
}

}

namespace {

std::mutex& verilator_initialization_mutex()
{
    static std::mutex mutex;
    return mutex;
}

// Verilator maps ports of up to 64 bits to integers and wider ports to VlWide word arrays.
template <typename Port>
void clear_port(Port& port)
{
    if constexpr (std::is_integral_v<Port>)
        port = 0;
    else
        std::fill(port.data(), port.data() + sizeof(port) / sizeof(EData), EData(0));
}

template <typename Port>
void write_bits(Port& port, unsigned offset, unsigned width, std::uint64_t value)
{
    if constexpr (std::is_integral_v<Port>)
    {
        const std::uint64_t mask = width >= 64 ? ~std::uint64_t(0) : (std::uint64_t(1) << width) - 1;
        port = static_cast<Port>(port | ((value & mask) << offset));
    }
    else
    {
        for (unsigned bit = 0; bit < width; ++bit)
            if ((value >> bit) & 1)
                port.at((offset + bit) / 32) |= EData(1) << ((offset + bit) % 32);
    }
}

template <typename Port>
std::uint64_t read_bits(const Port& port, unsigned offset, unsigned width)
{
    std::uint64_t value = 0;
    if constexpr (std::is_integral_v<Port>)
    {
        const std::uint64_t mask = width >= 64 ? ~std::uint64_t(0) : (std::uint64_t(1) << width) - 1;
        value = (static_cast<std::uint64_t>(port) >> offset) & mask;
    }
    else
    {
        for (unsigned bit = 0; bit < width; ++bit)
            if ((port.at((offset + bit) / 32) >> ((offset + bit) % 32)) & 1)
                value |= std::uint64_t(1) << bit;
    }
    return value;
}

// Output elements are sign-extended from their bus width when sign_extend is set, zero-extended otherwise.
constexpr bool sign_extend = {{ "true" if out_sign_extend else "false" }};

template <typename T>
T to_element(std::uint64_t value, unsigned width)
{
    if (sign_extend)
    {
        const std::uint64_t sign = std::uint64_t(1) << (width - 1);
        return static_cast<T>(static_cast<std::int64_t>((value ^ sign) - sign));
    }
    return static_cast<T>(value);
}

}

namespace hulotte::module {

void {{ class_name }}::Cycle_range::add(std::uint64_t value)
{
    min = count == 0 ? value : std::min(min, value);
    max = count == 0 ? value : std::max(max, value);
    sum += value;
    ++count;
}

{{ class_name }}::{{ class_name }}(int frame_size, const std::string& trace_path)
: {{ class_name }}(frame_size, frame_size, true, trace_path)
