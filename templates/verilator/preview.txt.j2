{%- endif %}

Or enable an optional VCD trace (use a distinct path per instance):
{%- if passthrough %}
    hulotte::module::{{ class_name }} {{ instance_name }}(frame_size, "traces/{{ instance_name }}.vcd");
{%- else %}
    hulotte::module::{{ class_name }} {{ instance_name }}(n_in, n_out, "traces/{{ instance_name }}.vcd");
{%- endif %}

