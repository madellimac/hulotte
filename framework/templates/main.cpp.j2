{% if not use_streampu %}
#include <iostream>

int main(int argc, char** argv)
{
    std::cout << "Starting Hulotte project (Basic C++)..." << std::endl;
    // Add your code here
    return 0;
}
{% else %}
#include <iostream>
#include <vector>
#include <fstream>
#include <streampu.hpp>
{% if use_aff3ct %}
#include <aff3ct.hpp>
{% endif %}
{% if use_hw %}
// NOTE: Hardware block headers are added automatically by add_hardware_module.py
// Example: #include "VModel_increment.h"  // Generated by Verilator
#include "VerilatorSimulation.hpp"
#include "VModel_PassThrough.h"
{% endif %}
{% if use_custom %}
#include "custom/MyModule.hpp"
{% endif %}
{% if use_uart_io %}
#include "UartFrameIO.hpp"
{% endif %}
#include "Comparator.hpp"

using namespace spu;
using namespace spu::module;

int main(int argc, char** argv)
{
    std::cout << "Starting Hulotte project..." << std::endl;

{% if use_aff3ct %}
    // 1. Modules creation

    // RS(7, 5) => t=1, m=3. Bits 21 -> 15.
    // NOTE: This uses aff3ct B_32 (32-bit integer) template instantiation.
    const int N_rs = 7;  // Symbols
    const int K_rs = 5;  // Symbols
    const int m = 3;       // Bits per symbol
    const int t = (N_rs - K_rs) / 2; // Correction
    const int N = N_rs * m; // Total bits
    const int K = K_rs * m; // Info bits

    module::Source_random<> source(K);
    Comparator               comparator(K);

    // Create RS Polynomial Generator (needed for RS construction)
    aff3ct::tools::RS_polynomial_generator poly(N_rs, t);

    // Create Encoder and Decoder
    aff3ct::module::Encoder_RS<>     encoder(K_rs, N_rs, poly);
    aff3ct::module::Decoder_RS_std<> decoder(K_rs, N_rs, poly);

    {% if use_uart_io %}
    // In AFF3CT mode, keep UART frame size aligned with K.
    module::UartFrameIO         uart_io("{{ uart_port }}", {{ uart_baud }}, K);
    {% endif %}

    {% if use_custom %}
    module::MyModule         my_module(K);
    {% endif %}
    {% if use_hw %}
    // NOTE: Keep a single traced HW instance by default.
    VerilatorSimulation<VModel_PassThrough> hw_passthrough(K, "trace_main", true);
    {% endif %}

    // 2. Sockets binding
    using namespace aff3ct::module;
    using namespace aff3ct::tools;

    // in_ref: source directly to comparator (reference path)
    source[src::tsk::generate][(int)src::sck::generate::out_data] = comparator["check::in_ref"];

    // in_got: source -> [uart ->] [hw ->] [custom ->] encoder -> decoder -> comparator
    {% if use_uart_io %}
    source[src::tsk::generate][(int)src::sck::generate::out_data] = uart_io["exchange::input"];
    {% if use_hw %}
    uart_io["exchange::output"] = hw_passthrough["simulate::input"];
    {% if use_custom %}
    hw_passthrough["simulate::output"] = my_module["process::in"];
    my_module["process::out"] = encoder[enc::tsk::encode][(int)enc::sck::encode::U_K];
    {% else %}
    hw_passthrough["simulate::output"] = encoder[enc::tsk::encode][(int)enc::sck::encode::U_K];
    {% endif %}
    {% elif use_custom %}
    uart_io["exchange::output"] = my_module["process::in"];
    my_module["process::out"] = encoder[enc::tsk::encode][(int)enc::sck::encode::U_K];
    {% else %}
    uart_io["exchange::output"] = encoder[enc::tsk::encode][(int)enc::sck::encode::U_K];
    {% endif %}
    {% elif use_hw %}
    source[src::tsk::generate][(int)src::sck::generate::out_data] = hw_passthrough["simulate::input"];
    {% if use_custom %}
    hw_passthrough["simulate::output"] = my_module["process::in"];
    my_module["process::out"] = encoder[enc::tsk::encode][(int)enc::sck::encode::U_K];
    {% else %}
    hw_passthrough["simulate::output"] = encoder[enc::tsk::encode][(int)enc::sck::encode::U_K];
    {% endif %}
    {% elif use_custom %}
    source[src::tsk::generate][(int)src::sck::generate::out_data] = my_module["process::in"];
    my_module["process::out"] = encoder[enc::tsk::encode][(int)enc::sck::encode::U_K];
    {% else %}
    source[src::tsk::generate][(int)src::sck::generate::out_data] = encoder[enc::tsk::encode][(int)enc::sck::encode::U_K];
    {% endif %}

    encoder[enc::tsk::encode][(int)enc::sck::encode::X_N]           = decoder[dec::tsk::decode_hiho][(int)dec::sck::decode_hiho::Y_N];
    decoder[dec::tsk::decode_hiho][(int)dec::sck::decode_hiho::V_K] = comparator["check::in_got"];

{% else %}
    // 1. Modules creation

    const int n_elmts = {% if use_uart_io %}{{ uart_frame_size }}{% else %}16{% endif %};
    module::Source_random<int> source(n_elmts);
    Comparator                  comparator(n_elmts);
    {% if use_uart_io %}
    module::UartFrameIO         uart_io("{{ uart_port }}", {{ uart_baud }}, n_elmts);
    {% endif %}
    {% if use_custom %}
    module::MyModule         my_module(n_elmts);
    {% endif %}
    {% if use_hw %}
    // NOTE: Keep a single traced HW instance by default.
    VerilatorSimulation<VModel_PassThrough> hw_passthrough(n_elmts, "trace_main", true);

    // Additional hardware blocks can be added using add_hardware_module.py
    // They are created with trace DISABLED to avoid Verilator context conflicts
    // Example (add via script):
    //   #include "VModel_increment.h"
    //   VerilatorSimulation<VModel_increment> hw_increment(n_elmts, "trace_increment", false);
    {% endif %}

    // 2. Sockets binding
    {% if use_hw and use_uart_io %}
    // Co-simulation mode: HW simulation vs FPGA real hardware
    // Both paths run in parallel; comparator checks if outputs match
    source["generate::out_data"] = hw_passthrough["simulate::input"];
    source["generate::out_data"] = uart_io["exchange::input"];
    hw_passthrough["simulate::output"]  = comparator["check::in_ref"];  // ref from Verilator
    uart_io["exchange::output"]         = comparator["check::in_got"];  // got from FPGA
    {% else %}
    // in_ref: source directly to comparator (reference -- unchanged data)
    source["generate::out_data"] = comparator["check::in_ref"];

    {% if use_uart_io %}
    // UART I/O mode: source -> UART -> [custom ->] comparator
    source["generate::out_data"] = uart_io["exchange::input"];
    {% if use_custom %}
    uart_io["exchange::output"] = my_module["process::in"];
    my_module["process::out"] = comparator["check::in_got"];
    {% else %}
    uart_io["exchange::output"] = comparator["check::in_got"];
    {% endif %}
    {% elif use_hw %}
    // Hardware simulation mode: source -> [hw pipeline ->] [custom ->] comparator
    source["generate::out_data"] = hw_passthrough["simulate::input"];
    {% if use_custom %}
    hw_passthrough["simulate::output"] = my_module["process::in"];
    my_module["process::out"] = comparator["check::in_got"];
    {% else %}
    hw_passthrough["simulate::output"] = comparator["check::in_got"];
    {% endif %}
    {% elif use_custom %}
    // Custom module mode: source -> custom module -> comparator
    source["generate::out_data"] = my_module["process::in"];
    my_module["process::out"]    = comparator["check::in_got"];
    {% else %}
    // Smoke test mode: source directly (always passes)
    source["generate::out_data"] = comparator["check::in_got"];
    {% endif %}
    {% endif %}
{% endif %}

    // 3. Sequence creation
    std::vector<runtime::Task*> first_tasks;
    first_tasks.push_back(&source("generate"));

    runtime::Sequence sequence(first_tasks);

    // Configuration
    for (auto& type : sequence.get_tasks_per_types())
        for (auto& t : type)
        {
            t->set_stats(true);
            t->set_debug(true);
        }

    // 4. Execution
    std::cout << "Processing..." << std::endl;

    // Export dot file for visualization
    std::ofstream file("graph.dot");
    sequence.export_dot(file);

    // Run the sequence
    for (auto i = 0; i < 3; i++)
        sequence.exec_seq(); // Run 1 frame at a time

    // 5. Stats
    std::cout << "\nEnd of execution." << std::endl;
    tools::Stats::show(sequence.get_tasks_per_types(), true, false);

    // 6. Non-regression check
    if (comparator.has_errors())
        std::cerr << "[FAIL] " << comparator.get_n_errors() << " error(s) detected over "
                  << comparator.get_frame_count() << " frame(s)." << std::endl;
    else
        std::cout << "[PASS] 0 errors over " << comparator.get_frame_count() << " frame(s)." << std::endl;

    return comparator.has_errors() ? 1 : 0;
}
{% endif %}
